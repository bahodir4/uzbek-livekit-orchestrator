# Never commit actual secrets. Start from: cp .env.example .env
LIVEKIT_URL=wss://YOUR_LIVEKIT_SERVER
LIVEKIT_API_KEY=YOUR_LIVEKIT_API_KEY
LIVEKIT_API_SECRET=YOUR_LIVEKIT_API_SECRET
STT_API_KEY=YOUR_ROTATED_STT_KEY
VLLM_API_KEY=EMPTY
TTS_API_KEY=REPLACE_WITH_THE_TTS_GATEWAY_KEY   # same value as TTS_API_KEY on the TTS pod
SAYRO_API_KEY=                                  # only if you run the optional legacy Sayro provider
# Password protecting /docs, /openapi.json, /admin/*
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_TO_LONG_RANDOM_PASSWORD
# Admin binds to localhost by default. Set 0.0.0.0 only behind TLS + access control.
ADMIN_HOST=127.0.0.1
ADMIN_PORT=8090
AGENT_CONFIG_PATH=
# Default outside Docker: AGENT_CONFIG_PATH=config/agent.yaml
LOG_LEVEL=INFO
# true on a public https site (the login cookie gets the Secure flag); false only for plain http on a local network
UI_SECURE_COOKIE=true
